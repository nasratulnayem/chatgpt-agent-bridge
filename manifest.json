{
  "manifest_version": 3,
  "name": "ChatGPT Agent Bridge",
  "version": "1.0.0",
  "description": "Model Context Protocol (MCP) bridge connecting AI Agents (Antigravity Cortex, Claude, Cursor) to your active ChatGPT Web session.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "activeTab",
    "tabs",
    "scripting",
    "storage",
    "alarms",
    "downloads"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "http://127.0.0.1:3456/*",
    "http://localhost:3456/*",
    "ws://127.0.0.1:3456/*",
    "ws://localhost:3456/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "ChatGPT Agent Bridge",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
